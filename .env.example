# ─── ProductScene environment variables ───────────────────────────────
# Copy this file to `.env.local` for local dev.
# Do NOT commit real secrets.

# HMAC signing secret for API keys (any long random string).
# Generate with: openssl rand -base64 48
SIGNING_SECRET=replace-with-long-random-string

# Fal.ai API key (https://fal.ai/dashboard/keys)
# If left blank, /api/generate returns branded placeholder images
# so the full UI flow remains demoable.
FAL_KEY=

# ─── Paddle (Billing) ────────────────────────────────────────────────
# Create at: Paddle → Developer tools → Authentication
PADDLE_WEBHOOK_SECRET=
PADDLE_CLIENT_TOKEN=

# Paddle Price / Product IDs (from Paddle Catalog)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_PRICE_STARTER=
NEXT_PUBLIC_PADDLE_PRICE_PRO=
NEXT_PUBLIC_PADDLE_PRICE_BUSINESS=
